#pragma clang diagnostic ignored "-Wmissing-prototypes"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct OutputInfo
{
    float4 options;
};

struct main0_out
{
    float4 out_color [[color(0)]];
};

struct main0_in
{
    float2 frag_uv [[user(locn0)]];
};

static inline __attribute__((always_inline))
float3 linear_to_srgb(thread const float3& c)
{
    return select(c * 12.9200000762939453125, (powr(fast::max(c, float3(0.0)), float3(0.4166666567325592041015625)) * 1.05499994754791259765625) - float3(0.054999999701976776123046875), c > float3(0.003130800090730190277099609375));
}

static inline __attribute__((always_inline))
float3 pq_encode(thread const float3& nits)
{
    float3 p = powr(fast::clamp(nits / float3(10000.0), float3(0.0), float3(1.0)), float3(0.1593017578125));
    return powr((float3(0.8359375) + (p * 18.8515625)) / (float3(1.0) + (p * 18.6875)), float3(78.84375));
}

fragment main0_out main0(main0_in in [[stage_in]], constant OutputInfo& info [[buffer(0)]], texture2d<float> scene [[texture(0)]], sampler sceneSmplr [[sampler(0)]])
{
    main0_out out = {};
    float3 rgb = scene.sample(sceneSmplr, in.frag_uv).xyz;
    if (info.options.x < 0.5)
    {
        float3 param = rgb;
        rgb = linear_to_srgb(param);
    }
    else
    {
        if (info.options.x < 1.5)
        {
            rgb *= info.options.y;
        }
        else
        {
            rgb = float3x3(float3(0.6274039745330810546875, 0.06909699738025665283203125, 0.01639099977910518646240234375), float3(0.3292829990386962890625, 0.919539988040924072265625, 0.088013000786304473876953125), float3(0.0433130003511905670166015625, 0.011362000368535518646240234375, 0.895595014095306396484375)) * rgb;
            float3 param_1 = rgb * info.options.z;
            rgb = pq_encode(param_1);
        }
    }
    out.out_color = float4(rgb, 1.0);
    return out;
}

